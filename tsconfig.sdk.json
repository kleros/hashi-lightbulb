{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "noEmit": false,
    /* Overriding Next.js defaults for Library compatibility */
    "module": "CommonJS", 
    "moduleResolution": "node",
    "isolatedModules": false, 
    "jsx": "react", 
    "paths": {
      "@/*": ["./src/*"] 
    }
  },
  "include": [
    "sdk/",
    "typechain-types/**/*.ts",
  ],
  "exclude": [
    "src",
    "node_modules",
    "test",
    "contracts"
  ]
}