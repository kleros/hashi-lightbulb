{
  "name": "@kleros/hashi",
  "version": "0.1.0",
  "main": "dist/sdk/index.js",
  "types": "dist/sdk/index.d.ts",
  "scripts": {
    "dev": "next dev",
    "build": "npm run gen:routes && next build",
    "build:sdk": "bash ./contracts/script/generate-types.sh && tsc -p tsconfig.sdk.json && npm run sync-assets",
    "sync-assets": "cp -r sdk/contracts dist/sdk/ && cp -r sdk/addresses dist/sdk/",
    "prepublishOnly": "npm run build:sdk",
    "start": "next start",
    "lint": "next lint",
    "gen:types": "bash ./contracts/script/generate-types.sh",
    "gen:routes": "ts-node src/scripts/gen-routes.cts"
  },
  "dependencies": {
    "@chainlink/contracts-ccip": "^0.7.6",
    "@headlessui/react": "^2.2.4",
    "@layerzerolabs/lz-evm-messagelib-v2": "^2.3.44",
    "@layerzerolabs/lz-evm-oapp-v2": "^2.3.44",
    "@layerzerolabs/lz-evm-protocol-v2": "^2.3.44",
    "@reown/appkit": "^1.8.2",
    "@reown/appkit-adapter-wagmi": "^1.8.2",
    "@tanstack/react-query": "^5.85.9",
    "next": "^15.4.10",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "solidity-rlp": "^2.0.8",
    "viem": "^2.32.0",
    "wagmi": "^2.16.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@typechain/ethers-v5": "^11.1.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.4.2",
    "tailwindcss": "^4",
    "typechain": "^8.3.2",
    "typescript": "^5"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/sdk/index.js",
    "./contracts/*.sol": "./dist/sdk/contracts/*.sol"
  }
}
